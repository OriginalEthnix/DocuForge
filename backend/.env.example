# DocuForge AI — Environment Configuration
# Copy this file to .env and fill in the values

# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME="DocuForge AI"
APP_VERSION="1.0.0"
DEBUG=false

# ─── Security ────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=your_very_long_random_secret_key_here_generate_new_one
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./docuforge.db

# ─── AI Provider ─────────────────────────────────────────────────────────────
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# ─── AWS S3 Cloud Storage ────────────────────────────────────────────────────
# Required AWS S3 permissions on S3_BUCKET_NAME:
#   s3:PutObject, s3:GetObject, s3:DeleteObject
AWS_REGION=eu-north-1
S3_BUCKET_NAME=your_s3_bucket_name_here
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
S3_PRESIGNED_URL_EXPIRE_SECONDS=900
MAX_UPLOAD_SIZE_MB=20

# ─── PlantUML ────────────────────────────────────────────────────────────────
PLANTUML_SERVER=https://www.plantuml.com/plantuml

# ─── CORS ────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# ─── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
AI_RATE_LIMIT_PER_MINUTE=10

# ─────────────────────────────────────────────────────────────────────────────
# QUICK START GUIDE
# ─────────────────────────────────────────────────────────────────────────────
# 1. Start Backend:
#    cd backend
#    .\venv\Scripts\uvicorn main:app --reload --port 8000
#
# 2. Start Frontend:
#    cd frontend
#    npm run dev
#
# 3. Run Backend Tests:
#    cd backend
#    .\venv\Scripts\python.exe -m pytest tests/ -v
#
# 4. Build Frontend:
#    cd frontend
#    npm run build
#
# 5. Database Migrations:
#    Migrations run automatically on application startup via run_migrations(engine)
#    in main.py without destructive data resets.
#
# 6. S3 Prefix Layout:
#    s3://BUCKET_NAME/
#        users/{user_id}/projects/{project_id}/
#            requirements/
#            user-stories/
#            srs-diagrams/
#            uml-diagrams/
#            dfd-diagrams/
#            database-design/
#            project-planning/
#            estimation/
#            risk-management/
#            test-cases/
#            traceability/
#            quality-metrics/
#            maintenance/
#            generated/ (PDF exports)
#            uploads/   (project files)
