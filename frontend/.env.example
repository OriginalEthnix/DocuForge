# DocuForge AI Frontend Environment Variables
# Copy this file to .env.local for local overrides, or configure these variables in Vercel project settings.

# ─── Backend API URL ─────────────────────────────────────────────────────────
# In local development: Leave blank or omit. Vite dev server proxies /api to http://localhost:8000.
# In production (e.g. Vercel): Set this to the public URL of your deployed FastAPI backend.
# Examples:
#   VITE_API_URL=https://your-docuforge-backend.onrender.com
#   VITE_API_URL=https://api.docuforge.ai
VITE_API_URL=
